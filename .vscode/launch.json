{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32WB55: Build, Flash and Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/STM32WB55_OTA.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "searchDir": [
                "/opt/homebrew/opt/open-ocd/share/openocd/scripts"
            ],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32wbx.cfg"
            ],
            "armToolchainPath": "/Applications/ArmGNUToolchain/14.3.rel1/arm-none-eabi/bin",
            "preLaunchTask": "CMake: Build Debug",
            "runToEntryPoint": "App_Run"
        }
    ]
}
